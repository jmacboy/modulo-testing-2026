  "item": [
    {
      "name": "get item list",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response is a json object\", function () {\r",
              "    pm.expect(pm.response.json()).to.be.an('object');\r",
              "});\r",
              "const responseJson = pm.response.json();\r",
              "pm.test(\"Response contains a value array\", function () {\r",
              "    pm.expect(responseJson).to.have.property(\"value\");\r",
              "    pm.expect(responseJson.value).to.be.an('array');\r",
              "});\r",
              "const valueArray = responseJson.value;\r",
              "if (valueArray.length > 0) {\r",
              "    pm.test(\"First item in value array has an id\", function () {\r",
              "        pm.expect(valueArray[0]).to.have.property(\"id\");\r",
              "        pm.expect(valueArray[0].id).to.be.a('string');\r",
              "    });\r",
              "\r",
              "    pm.test(\"First item in value array has an itemName\", function () {\r",
              "        pm.expect(valueArray[0]).to.have.property(\"itemName\");\r",
              "        pm.expect(valueArray[0].itemName).to.be.a('string');\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
